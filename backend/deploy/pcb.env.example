PCB_DATA_DIR=/var/lib/pcb
PCB_MODELS_CONFIG=/opt/pcb/backend/models.json
PCB_LOCAL_CONCURRENCY=1
PCB_TORCH_THREADS=2
PCB_VLM_CONCURRENCY=2
PCB_VLM_DAILY_LIMIT=100
QWEN_API_KEY=
# For a trusted corporate proxy only, install its CA and configure this absolute path:
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Writable framework configuration; model weights remain read-only.
YOLO_CONFIG_DIR=/var/lib/pcb/ultralytics
MPLCONFIGDIR=/var/lib/pcb/matplotlib
